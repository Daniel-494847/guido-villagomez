rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esAnonimo() {
      return autenticado() &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function cursoActivo(cursoId) {
      return exists(/databases/$(database)/documents/cursos/$(cursoId)) &&
        get(/databases/$(database)/documents/cursos/$(cursoId)).data.activo == true;
    }

    function esAdministrador() {
      return autenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function esPersonal() {
      return autenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'docente'];
    }

    match /usuarios/{uid} {
      allow get: if autenticado() && request.auth.uid == uid || esAdministrador();
      allow list: if esAdministrador();
      allow create, update, delete: if esAdministrador();
    }

    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    // Cursos: metadatos SIN preguntas (nombre, área, minutos, estado).
    // Los estudiantes pueden leerlos para saber área y tiempo.
    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    // PRUEBAS: preguntas SIN la clave de respuesta correcta (campo c).
    // Es lo único de preguntas que un estudiante anónimo puede leer.
    match /pruebas/{cursoId} {
      allow read: if true;
      allow write: if esAdministrador();
    }

    // EXÁMENES: pregunta + OPCIONES + CLAVE (c) + calificación.
    // Solo el personal autorizado puede leer o escribir.
    match /examenes/{cursoId} {
      allow read, write: if esPersonal();
    }

    // CLAVES DE CALIFICACIÓN: respuestas correctas por pregunta.
    // Solo el personal autorizado puede leer (se usan para recalcular notas).
    match /claves/{cursoId} {
      allow read, write: if esPersonal();
    }

    match /estudiantes/{estudianteId} {
      allow get: if esPersonal() ||
        (esAnonimo() &&
          (!exists(/databases/$(database)/documents/estudiantes/$(estudianteId)) ||
            (resource.data.authUid == request.auth.uid &&
              !exists(/databases/$(database)/documents/resultados/$(estudianteId)))));
      allow list: if esPersonal();
      allow create: if esAnonimo() &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.cursoId is string &&
        cursoActivo(request.resource.data.cursoId);
      allow update, delete: if esAdministrador();
    }

    // Borradores de respuestas guardados pregunta por pregunta
    match /respuestas/{docId} {
      allow get: if esPersonal() ||
        (esAnonimo() &&
          (!exists(/databases/$(database)/documents/respuestas/$(docId)) ||
            resource.data.authUid == request.auth.uid));
      allow create, update: if esAnonimo() &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.estudianteId is string;
      allow delete: if esPersonal() ||
        (esAnonimo() && resource.data.authUid == request.auth.uid);
    }

    match /resultados/{resultadoId} {
      // Solo el personal puede leer resultados y notas.
      allow get, list: if esPersonal();
      // El estudiante envía solo sus respuestas (sin nota ni claves);
      // el personal recalcula y guarda nota/aciertos/desaciertos.
      allow create: if esAnonimo() &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.respuestas is list &&
        request.resource.data.cursoId is string &&
        request.resource.data.aciertos == 0 &&
        request.resource.data.desaciertos == 0 &&
        request.resource.data.nota == 0;
      allow update, delete: if esAdministrador();
    }
  }
}
